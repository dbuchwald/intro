{
    "extends": ["eslint:recommended", "plugin:jest/recommended"],
    "ecmaFeatures": {
        "jsx": true,
        "modules":true,
        "arrowFunctions":true,
        "classes":true,
        "spread":true
    },
    "env": {
        "es6": true,
        "node": true
    },
    "rules": {
        "no-console": "off"
    }
}
